<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application layer: DTOs, interfaces (ports), services, validators, business rules. -->
  <PropertyGroup>
    <RootNamespace>FurnitureStore.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FurnitureStore.Domain\FurnitureStore.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FurnitureStore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 34 provinces and 3,321 wards / communes in effect since 01/07/2025, used by VietnamProvinces. -->
    <EmbeddedResource Include="Sales\Data\vietnam-administrative-units.json" LogicalName="FurnitureStore.Application.Sales.Data.vietnam-administrative-units.json" />
  </ItemGroup>

</Project>
