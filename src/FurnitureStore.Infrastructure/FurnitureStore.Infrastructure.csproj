    <RootNamespace>FurnitureStore.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives access to ASP.NET Core shared framework types (Identity, IWebHostEnvironment, HttpClientFactory...). -->
