@model FurnitureStore.Application.Engagement.ContactMessageDto
@using FurnitureStore.Domain.Enums
@inject FurnitureStore.Application.Engagement.IStoreInfoService StoreInfo
@{
    var store = await StoreInfo.GetAsync(Context.RequestAborted);
    ViewData["Title"] = $"Liên hệ từ {Model.FullName}";
}
<a href="/admin/contacts" class="d-inline-block mb-3 text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Liên hệ</a>
<div class="row g-3">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header"><h2>@(Model.Subject ?? "(Không có tiêu đề)")</h2><span class="small text-muted-fs">@Format.DateTimeText(Model.CreatedAt)</span></div>
            <div class="admin-card-body">
                <p class="small text-muted-fs">@Model.FullName · <a href="tel:@Model.Phone">@Model.Phone</a> · <a href="mailto:@Model.Email">@Model.Email</a> · IP @Model.IpAddress</p>
                <div class="contact-message">@Model.Message</div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="admin-card">
            <div class="admin-card-header"><h2>Xử lý</h2></div>
            <div class="admin-card-body">
                <form method="post" asp-action="Update" asp-route-id="@Model.Id">
                    <label class="form-label small" for="status">Trạng thái</label>
                    <select id="status" name="status" class="form-select mb-2">
                        <option value="Read" selected="@(Model.Status == ContactMessageStatus.Read)">Đã xem</option>
                        <option value="Replied" selected="@(Model.Status == ContactMessageStatus.Replied)">Đã phản hồi</option>
                        <option value="Archived" selected="@(Model.Status == ContactMessageStatus.Archived)">Lưu trữ</option>
                    </select>
                    <label class="form-label small" for="adminNote">Ghi chú nội bộ</label>
                    <textarea id="adminNote" name="adminNote" class="form-control mb-2" rows="4" maxlength="1000">@Model.AdminNote</textarea>
                    <button type="submit" class="btn btn-primary w-100">Lưu</button>
                </form>
                <a class="btn btn-outline-primary w-100 mt-2" href="mailto:@Model.Email?subject=@Uri.EscapeDataString($"Phản hồi liên hệ - {store.Name}")"><i class="bi bi-envelope me-1" aria-hidden="true"></i>Trả lời qua email</a>
            </div>
        </div>
    </div>
</div>
