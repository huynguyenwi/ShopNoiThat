@model FurnitureStore.Application.Engagement.StoreInfoCommand
@{
    ViewData["Title"] = "Thông tin cửa hàng";
}

<form method="post" asp-action="Index" novalidate style="max-width: 920px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="admin-card mb-3">
        <div class="admin-card-header"><h2>Thông tin hiển thị trên website</h2></div>
        <div class="admin-card-body row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Tên cửa hàng *</label>
                <input asp-for="Name" class="form-control" maxlength="150" data-logo-source="name" aria-describedby="nameHelp" />
                <div class="form-text" id="nameHelp">Hiện trên logo (header, footer), tiêu đề trang, khung chat và email gửi khách.</div>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LogoSubtitle" class="form-label">Dòng chữ nhỏ dưới logo</label>
                <input asp-for="LogoSubtitle" class="form-control" maxlength="40" placeholder="Furniture" data-logo-source="subtitle" aria-describedby="logoSubtitleHelp" />
                <div class="form-text" id="logoSubtitleHelp">Tên kết thúc bằng chữ này thì logo tách 2 dòng: "Nhà Mộc <strong>Furniture</strong>" → Nhà Mộc / FURNITURE. Để trống: logo chỉ hiện tên.</div>
                <span asp-validation-for="LogoSubtitle" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <div class="small text-muted-fs mb-1">Logo sẽ hiển thị:</div>
                <div class="store-logo-preview" data-logo-preview aria-live="polite">
                    <img src="~/images/logo-mark.svg" width="40" height="40" alt="" />
                    <span class="brand-text">
                        <span class="brand-name" data-logo-name>@FurnitureStore.Application.Engagement.StoreInfoDto.BrandNameOf(Model.Name ?? string.Empty, Model.LogoSubtitle)</span>
                        <span class="brand-sub" data-logo-sub hidden="@string.IsNullOrWhiteSpace(Model.LogoSubtitle)">@Model.LogoSubtitle</span>
                    </span>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Tagline" class="form-label">Khẩu hiệu</label>
                <input asp-for="Tagline" class="form-control" maxlength="200" />
            </div>
            <div class="col-12">
                <label asp-for="About" class="form-label">Giới thiệu</label>
                <textarea asp-for="About" class="form-control" rows="3" maxlength="4000"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="Address" class="form-label">Địa chỉ showroom *</label>
                <input asp-for="Address" class="form-control" maxlength="300" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="WorkshopAddress" class="form-label">Địa chỉ xưởng</label>
                <input asp-for="WorkshopAddress" class="form-control" maxlength="300" />
            </div>
            <div class="col-md-4">
                <label asp-for="Hotline" class="form-label">Hotline *</label>
                <input asp-for="Hotline" class="form-control" maxlength="30" />
                <span asp-validation-for="Hotline" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Email" class="form-label">Email *</label>
                <input asp-for="Email" class="form-control" maxlength="256" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="OpeningHours" class="form-label">Giờ mở cửa</label>
                <input asp-for="OpeningHours" class="form-control" maxlength="150" />
            </div>
        </div>
    </div>
    <div class="admin-card mb-3">
        <div class="admin-card-header"><h2>Mạng xã hội &amp; bản đồ</h2></div>
        <div class="admin-card-body row g-3">
            <div class="col-md-4">
                <label asp-for="FacebookUrl" class="form-label">Facebook</label>
                <input asp-for="FacebookUrl" class="form-control" placeholder="https://facebook.com/..." />
                <span asp-validation-for="FacebookUrl" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TikTokUrl" class="form-label">TikTok</label>
                <input asp-for="TikTokUrl" class="form-control" placeholder="https://tiktok.com/@@..." />
                <span asp-validation-for="TikTokUrl" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ZaloUrl" class="form-label">Zalo</label>
                <input asp-for="ZaloUrl" class="form-control" placeholder="https://zalo.me/..." />
                <span asp-validation-for="ZaloUrl" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="GoogleMapsEmbedUrl" class="form-label">Link nhúng Google Maps</label>
                <input asp-for="GoogleMapsEmbedUrl" class="form-control" placeholder="https://www.google.com/maps?q=...&output=embed" />
                <div class="form-text">Google Maps → Chia sẻ → Nhúng bản đồ → sao chép giá trị <code>src</code>.</div>
                <span asp-validation-for="GoogleMapsEmbedUrl" class="text-danger small"></span>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1" aria-hidden="true"></i>Lưu thông tin</button>
    <a class="btn btn-light ms-2" href="/admin/banner"><i class="bi bi-image me-1" aria-hidden="true"></i>Sửa banner trang chủ</a>
</form>

@section Scripts {
    <script src="~/js/admin-store.js" asp-append-version="true"></script>
}
