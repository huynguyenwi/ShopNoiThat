@model IReadOnlyList<FurnitureStore.Application.Admin.NotificationDto>
@{
    ViewData["Title"] = "Thông báo";
}
<div class="admin-card" style="max-width: 860px">
    <div class="admin-card-header">
        <h2>Thông báo gần đây</h2>
        <form method="post" action="/admin/notifications/read" asp-antiforgery="true">
            <button type="submit" class="btn btn-light btn-sm"><i class="bi bi-check2-all me-1" aria-hidden="true"></i>Đánh dấu đã đọc tất cả</button>
        </form>
    </div>
    <div class="list-group list-group-flush">
        @if (Model.Count == 0)
        {
            <div class="list-group-item text-center text-muted-fs py-4">Chưa có thông báo.</div>
        }
        @foreach (var n in Model)
        {
            <a class="list-group-item list-group-item-action @(n.IsRead ? "" : "fw-semibold bg-cream")" href="@(n.Link ?? "#")">
                <div class="d-flex justify-content-between gap-2">
                    <span>@n.Title</span>
                    <span class="small text-muted-fs fw-normal text-nowrap">@Format.DateTimeText(n.CreatedAt)</span>
                </div>
                <div class="small text-muted-fs fw-normal">@n.Message</div>
            </a>
        }
    </div>
</div>
