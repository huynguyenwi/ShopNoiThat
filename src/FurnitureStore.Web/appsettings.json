{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FurnitureStoreDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },
  "Seed": {
    "AdminEmail": "admin@furniture.local",
    "AdminFullName": "Quản trị viên",
    "AdminPassword": "",
    "DemoUserEmail": "khachhang@furniture.local",
    "DemoUserFullName": "Khách hàng Demo",
    "DemoUserPassword": ""
  },
  "ApplicationSettings": {
    "SiteName": "Nhà Mộc Furniture",
    "Tagline": "Bàn ghế ăn gỗ sồi Nga - Đóng tại xưởng",
    "BaseUrl": "https://localhost:7160",
    "DefaultPageSize": 12,
    "FocusCategorySlug": "bo-ban-an",
    "Store": {
      "Name": "Nhà Mộc Furniture",
      "Address": "123 Đường Nguyễn Văn Linh, Phường Tân Phong, Quận 7, TP. Hồ Chí Minh",
      "WorkshopAddress": "Lô B2, KCN Tân Uyên, Bình Dương",
      "Hotline": "1900 0000",
      "Email": "contact@furniture.local",
      "OpeningHours": "08:00 - 21:00 (Thứ 2 - Chủ nhật)",
      "FacebookUrl": "https://facebook.com/",
      "TikTokUrl": "https://tiktok.com/",
      "ZaloUrl": "https://zalo.me/",
      "GoogleMapsEmbedUrl": "https://www.google.com/maps?q=Qu%E1%BA%ADn%207%2C%20TP.%20H%E1%BB%93%20Ch%C3%AD%20Minh&output=embed"
    }
  },
  "AI": {
    "Enabled": true,
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4o-mini",
    "ApiKey": "",
    "MaxOutputTokens": 800,
    "Temperature": 0.3,
    "TimeoutSeconds": 60,
    "RequestsPerMinute": 10,
    "JsonMode": true,
    "TokenLimitParameter": "max_tokens",
    "SendTemperature": true
  },
  "Payment": {
    "EnabledMethods": [ "COD", "BankTransfer" ],
    "BankTransfer": {
      "BankName": "Ngân hàng TMCP Demo",
      "AccountNumber": "0000 1234 5678",
      "AccountName": "CONG TY TNHH NHA MOC FURNITURE",
      "Branch": "Chi nhánh TP. Hồ Chí Minh",
      "TransferNotePrefix": "NHAMOC"
    }
  },
  "Email": {
    "Mode": "Pickup",
    "FromAddress": "no-reply@furniture.local",
    "FromName": "Nhà Mộc Furniture",
    "PickupDirectory": "App_Data/emails",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": ""
    }
  },
  "RateLimiting": {
    "AuthenticationPermitsPerMinute": 10,
    "FormPermitsPerMinute": 5,
    "ApiPermitsPerMinute": 300
  },
  "Seo": {
    "AllowIndexing": true,
    "DefaultOgImage": "/images/og-default.png"
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootFolder": "uploads",
    "MaxFileSizeMb": 50,
    "MaxImageMegapixels": 100,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".jfif", ".png", ".webp" ]
  }
}
