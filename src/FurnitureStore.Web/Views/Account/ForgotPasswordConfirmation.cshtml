@{
    ViewData["Title"] = "Kiểm tra email của bạn";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card auth-card-narrow">
            <div class="auth-form text-center">
                <span class="auth-icon"><i class="bi bi-envelope-check" aria-hidden="true"></i></span>
                <h1 class="h3 mb-2">Kiểm tra email của bạn</h1>
                <p class="text-muted-fs">Chúng tôi đã gửi liên kết đặt lại mật khẩu đến địa chỉ email của bạn. Vui lòng kiểm tra hộp thư đến (hoặc thư mục Spam).
                    Liên kết có hiệu lực trong 2 giờ.</p>
                <a class="btn btn-primary mt-2" asp-action="Login">Quay lại đăng nhập</a>
            </div>
        </div>
    </div>
</section>
