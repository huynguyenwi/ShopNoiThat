@model FurnitureStore.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card">
            <div class="auth-aside d-none d-lg-flex">
                <div>
                    <p class="section-eyebrow" style="color: var(--fs-sand)">Thành viên Nhà Mộc</p>
                    <h2 class="text-white">Tạo tài khoản để mua sắm nhanh hơn.</h2>
                    <ul class="auth-benefits">
                        <li><i class="bi bi-bag-check" aria-hidden="true"></i>Đặt hàng và thanh toán nhanh</li>
                        <li><i class="bi bi-geo-alt" aria-hidden="true"></i>Lưu nhiều địa chỉ giao hàng</li>
                        <li><i class="bi bi-chat-heart" aria-hidden="true"></i>Chat trực tiếp với tư vấn viên</li>
                    </ul>
                </div>
                <img src="~/images/hero-living-room.svg" alt="" width="360" height="292" />
            </div>

            <div class="auth-form">
                <h1 class="h3 mb-1">Đăng ký</h1>
                <p class="text-muted-fs mb-4">Đã có tài khoản? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a></p>

                <form asp-action="Register" method="post" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" placeholder="ban@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" placeholder="0912345678" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="passwordHelp" />
                            <button class="btn btn-outline-secondary password-toggle" type="button" data-toggle-password="Password" aria-label="Hiện mật khẩu"><i class="bi bi-eye" aria-hidden="true"></i></button>
                        </div>
                        <div id="passwordHelp" class="form-text">Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường và chữ số.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="AcceptTerms" class="form-check-input" />
                        <label asp-for="AcceptTerms" class="form-check-label small"></label>
                        <span asp-validation-for="AcceptTerms" class="text-danger small d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg">Tạo tài khoản</button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
