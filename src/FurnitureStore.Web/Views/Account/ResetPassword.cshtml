@model FurnitureStore.Web.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card auth-card-narrow">
            <div class="auth-form">
                <span class="auth-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
                <h1 class="h3 mb-1">Đặt lại mật khẩu</h1>
                <p class="text-muted-fs mb-4">Tạo mật khẩu mới cho tài khoản <strong>@Model.Email</strong>.</p>

                <form asp-action="ResetPassword" method="post" novalidate>
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Code" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
                            <button class="btn btn-outline-secondary password-toggle" type="button" data-toggle-password="Password" aria-label="Hiện mật khẩu"><i class="bi bi-eye" aria-hidden="true"></i></button>
                        </div>
                        <div class="form-text">Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường và chữ số.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 btn-lg">Lưu mật khẩu mới</button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
