@model FurnitureStore.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card auth-card-narrow">
            <div class="auth-form">
                <span class="auth-icon"><i class="bi bi-key" aria-hidden="true"></i></span>
                <h1 class="h3 mb-1">Quên mật khẩu</h1>
                <p class="text-muted-fs mb-4">Nhập email đã đăng ký, chúng tôi sẽ gửi liên kết để bạn đặt lại mật khẩu.</p>

                <form asp-action="ForgotPassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" autofocus placeholder="ban@email.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 btn-lg">Gửi liên kết đặt lại</button>
                </form>

                <p class="text-center mt-4 mb-0"><a asp-action="Login"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Quay lại đăng nhập</a></p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
