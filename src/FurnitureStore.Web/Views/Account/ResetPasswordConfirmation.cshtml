@{
    ViewData["Title"] = "Đã đặt lại mật khẩu";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-card auth-card-narrow">
            <div class="auth-form text-center">
                <span class="auth-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
                <h1 class="h3 mb-2">Đặt lại mật khẩu thành công</h1>
                <p class="text-muted-fs">Bạn có thể đăng nhập bằng mật khẩu mới.</p>
                <a class="btn btn-primary mt-2" asp-action="Login">Đăng nhập</a>
            </div>
        </div>
    </div>
</section>
