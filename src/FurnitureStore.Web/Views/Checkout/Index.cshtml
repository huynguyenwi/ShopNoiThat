@model FurnitureStore.Web.ViewModels.Sales.CheckoutViewModel
@inject IStoreInfoService StoreInfo
@{
    ViewData["Title"] = "Liên hệ đặt hàng";
    var store = await StoreInfo.GetAsync(Context.RequestAborted);
    var c = Model.Command;
    var message = TempData[CartController.MessageKey] as string;
}

<section class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-2">
                <li class="breadcrumb-item"><a href="/cart">Giỏ hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Liên hệ đặt hàng</li>
            </ol>
        </nav>
        <h1 class="page-title">Liên hệ đặt hàng</h1>
        <p class="text-muted-fs mb-0">Để lại thông tin, cửa hàng sẽ gọi lại xác nhận mẫu, giá và báo phí giao hàng &amp; lắp đặt. Website không thu tiền trực tuyến.</p>
    </div>
</section>

<section class="section pt-4">
    <div class="container">
        <partial name="_StatusMessage" model="message" />
        <div class="row g-4">
            <div class="col-lg-7">
                <form method="post" asp-action="Place" novalidate id="checkoutForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="panel mb-4">
                            <h2 class="h5 mb-3"><i class="bi bi-person me-2" aria-hidden="true"></i>Thông tin liên hệ &amp; nhận hàng</h2>

                            @if (Model.SavedAddresses.Count > 0)
                            {
                                <div class="saved-addresses mb-3" role="radiogroup" aria-label="Địa chỉ đã lưu">
                                    @foreach (var address in Model.SavedAddresses)
                                    {
                                        <label class="saved-address">
                                            <input type="radio" name="savedAddress" class="form-check-input"
                                                   data-address-fill
                                                   data-name="@address.RecipientName" data-phone="@address.Phone" data-line="@address.AddressLine"
                                                   data-ward="@address.Ward" data-province="@address.Province"
                                                   checked="@(address.AddressLine == c.AddressLine && address.Phone == c.Phone)" />
                                            <span>
                                                <strong>@address.RecipientName</strong> · @address.Phone
                                                @if (address.IsDefault)
                                                {
                                                    <span class="badge text-bg-light">Mặc định</span>
                                                }
                                                <span class="d-block small text-muted-fs">@address.FullAddress</span>
                                            </span>
                                        </label>
                                    }
                                </div>
                            }

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Command.FullName" class="form-label">Họ và tên *</label>
                                    <input asp-for="Command.FullName" class="form-control" autocomplete="name" required maxlength="150" />
                                    <span asp-validation-for="Command.FullName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Command.Phone" class="form-label">Số điện thoại *</label>
                                    <input asp-for="Command.Phone" class="form-control" type="tel" autocomplete="tel" required placeholder="0912345678" />
                                    <span asp-validation-for="Command.Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Command.Email" class="form-label">Email nhận xác nhận đơn *</label>
                                    <input asp-for="Command.Email" class="form-control" type="email" autocomplete="email" required />
                                    <span asp-validation-for="Command.Email" class="text-danger small"></span>
                                </div>
                                <partial name="_AddressPicker" model="new FurnitureStore.Web.ViewModels.Sales.AddressPickerModel(c.Province, c.Ward)" />
                                <div class="col-12">
                                    <label asp-for="Command.AddressLine" class="form-label">Số nhà, tên đường *</label>
                                    <input asp-for="Command.AddressLine" class="form-control" autocomplete="street-address" required maxlength="300" />
                                    <span asp-validation-for="Command.AddressLine" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Command.Note" class="form-label">Ghi chú cho cửa hàng</label>
                                    <textarea asp-for="Command.Note" class="form-control" rows="2" maxlength="1000" placeholder="VD: Gọi sau 18h, nhà tầng 3 có thang máy, muốn xem mẫu gỗ trước..."></textarea>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input asp-for="Command.SaveAddress" class="form-check-input" />
                                        <label asp-for="Command.SaveAddress" class="form-check-label">Lưu địa chỉ này vào sổ địa chỉ</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="panel">
                            <h2 class="h5 mb-3"><i class="bi bi-telephone-inbound me-2" aria-hidden="true"></i>Sau khi gửi yêu cầu</h2>
                            <ol class="contact-steps">
                                <li><strong>Cửa hàng gọi lại</strong> trong giờ làm việc@(string.IsNullOrWhiteSpace(store.OpeningHours) ? "" : $" ({store.OpeningHours})") để xác nhận mẫu, màu và kích thước.</li>
                                <li><strong>Báo phí giao hàng &amp; lắp đặt</strong> theo địa chỉ, số món và tầng lầu, rồi hẹn lịch giao.</li>
                                <li><strong>Thanh toán khi nhận hàng</strong> hoặc chuyển khoản theo hướng dẫn của nhân viên.</li>
                            </ol>
                            <span asp-validation-for="Command.PaymentMethod" class="text-danger small d-block mt-2"></span>
                            <p class="small text-muted-fs mt-3 mb-0"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i>
                                Website không thu thập hay lưu thông tin thẻ ngân hàng.
                                @if (!string.IsNullOrWhiteSpace(store.Hotline))
                                {
                                    <text>Cần gấp? Gọi <a href="tel:@store.HotlineDigits">@store.Hotline</a>.</text>
                                }
                            </p>
                        </div>
                </form>
            </div>

            <div class="col-lg-5">
                <aside class="order-summary sticky-lg-top" data-checkout-summary>
                    <partial name="_CheckoutSummary" model="Model.Summary" />
                </aside>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/address-picker.js" asp-append-version="true"></script>
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
