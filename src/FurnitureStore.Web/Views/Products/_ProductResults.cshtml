@model FurnitureStore.Web.ViewModels.Catalog.ProductListViewModel
@using FurnitureStore.Web.ViewModels.Catalog
@{
    var result = Model.Result;
    var chips = Model.Chips;
    Func<int, string> pageUrl = Model.Request.PageUrl;
}
<div class="results-toolbar">
    <div>
        <button class="btn btn-outline-primary btn-sm d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterPanel" aria-controls="filterPanel">
            <i class="bi bi-sliders me-1" aria-hidden="true"></i>Bộ lọc
        </button>
        <span class="text-muted-fs small" data-result-count>@Format.Number(result.TotalCount) sản phẩm</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <label for="sortSelect" class="small text-muted-fs text-nowrap">Sắp xếp</label>
        <select id="sortSelect" class="form-select form-select-sm" data-sort-select>
            @foreach (var option in ProductListRequest.SortOptions)
            {
                var selected = string.Equals(Model.Request.Sort ?? "newest", option.Key, StringComparison.OrdinalIgnoreCase);
                <option value="@option.Key" selected="@selected">@option.Label</option>
            }
        </select>
    </div>
</div>

@if (chips.Count > 0)
{
    <div class="filter-chips">
        @foreach (var chip in chips)
        {
            <a class="filter-chip" href="@chip.RemoveUrl" data-filter-link aria-label="Bỏ lọc @chip.Label">@chip.Label <i class="bi bi-x" aria-hidden="true"></i></a>
        }
        <a class="filter-chip filter-chip-clear" href="/products" data-filter-link>Xóa tất cả</a>
    </div>
}

@if (result.Items.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-search" aria-hidden="true"></i>
        <h2 class="h5 mt-3">Không tìm thấy sản phẩm phù hợp</h2>
        <p class="text-muted-fs">Hãy thử bỏ bớt bộ lọc hoặc tìm với từ khóa khác.</p>
        <a class="btn btn-outline-primary" href="/products">Xem tất cả sản phẩm</a>
    </div>
}
else
{
    <div class="row g-3 g-md-4 product-grid">
        @foreach (var product in result.Items)
        {
            <div class="col-6 col-md-4">
                <partial name="_ProductCard" model="product" />
            </div>
        }
    </div>
    <partial name="_Pagination" model="(result.Page, result.TotalPages, pageUrl)" />
}
