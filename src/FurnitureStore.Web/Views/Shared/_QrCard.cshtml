@model FurnitureStore.Web.ViewModels.QrCardModel
@{
    Func<object?, object> body = @<div class="qr-card-body">
        <img class="qr-image" src="@Model.ImageUrl" width="180" height="180" alt="@Model.ImageAlt" loading="lazy" />
        <p class="small text-muted-fs mt-2 mb-2">@Model.Hint</p>
        @if (Model.TargetUrl is not null)
        {
            <p class="small text-break mb-2"><code class="qr-target" data-qr-target>@Model.TargetUrl</code></p>
        }
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-outline-primary btn-sm" href="@Model.DownloadUrl" download data-qr-download><i class="bi bi-download me-1" aria-hidden="true"></i>Tải ảnh PNG</a>
            @if (Model.PrintUrl is not null)
            {
                <a class="btn btn-outline-primary btn-sm" href="@Model.PrintUrl" target="_blank" rel="noopener" data-qr-print><i class="bi bi-printer me-1" aria-hidden="true"></i>@Model.PrintLabel</a>
            }
        </div>
    </div>;
}
@if (Model.Admin)
{
    <div class="admin-card mb-3" data-qr-card>
        <div class="admin-card-header"><h2><i class="bi bi-qr-code me-1" aria-hidden="true"></i>@Model.Title</h2></div>
        <div class="admin-card-body">@body(null)</div>
    </div>
}
else
{
    <div class="panel mb-4" data-qr-card>
        <h2 class="h6 mb-3"><i class="bi bi-qr-code me-1" aria-hidden="true"></i>@Model.Title</h2>
        @body(null)
    </div>
}
