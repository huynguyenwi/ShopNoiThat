@model FurnitureStore.Application.Sales.CartDto
@{
    ViewData["Title"] = "Giỏ hàng";
    var message = TempData[CartController.MessageKey] as string;
}

<section class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-2">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Giỏ hàng</li>
            </ol>
        </nav>
        <h1 class="page-title">Giỏ hàng <span class="text-muted-fs fs-5">(@Model.TotalQuantity sản phẩm)</span></h1>
    </div>
</section>

<section class="section pt-4">
    <div class="container">
        <div data-cart-status>
            <partial name="_StatusMessage" model="message" />
        </div>

        <div data-cart-content>
            <partial name="_CartContent" model="Model" />
        </div>
    </div>
</section>
