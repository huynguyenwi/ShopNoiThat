@model FurnitureStore.Application.Sales.CartDto
@{
    ViewData["Title"] = "Giỏ hàng";
    var message = TempData[CartController.MessageKey] as string;
    var offers = ViewData["CouponOffers"] as IReadOnlyList<FurnitureStore.Application.Sales.CouponOfferDto> ?? [];
    var couponBox = new FurnitureStore.Web.ViewModels.Sales.CouponBoxModel(Model, offers, "/cart");
}

<section class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-2">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Giỏ hàng</li>
            </ol>
        </nav>
        <h1 class="page-title">Giỏ hàng <span class="text-muted-fs fs-5">(@Model.TotalQuantity sản phẩm)</span></h1>
    </div>
</section>

<section class="section pt-4">
    <div class="container">
        <partial name="_StatusMessage" model="message" />

        @if (Model.IsEmpty)
        {
            <div class="empty-state">
                <i class="bi bi-bag" aria-hidden="true"></i>
                <h2 class="h5 mt-3">Giỏ hàng của bạn đang trống</h2>
                <p class="text-muted-fs">Khám phá các mẫu nội thất gỗ và thêm sản phẩm yêu thích vào giỏ.</p>
                <a class="btn btn-primary" href="/products">Tiếp tục mua sắm</a>
            </div>
        }
        else
        {
            @foreach (var warning in Model.Warnings)
            {
                <div class="alert alert-warning py-2 d-flex gap-2" role="alert"><i class="bi bi-exclamation-triangle mt-1" aria-hidden="true"></i>@warning</div>
            }

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="cart-list">
                        @foreach (var line in Model.Items)
                        {
                            <article class="cart-line @(line.IsAvailable ? "" : "is-unavailable")">
                                <a class="cart-line-image" href="@line.Url">
                                    @if (line.ImageUrl is not null)
                                    {
                                        <img src="@line.ImageUrl" alt="@line.ProductName" width="120" height="90" loading="lazy" />
                                    }
                                </a>
                                <div class="cart-line-info">
                                    <h2 class="cart-line-title"><a href="@line.Url">@line.ProductName</a></h2>
                                    <div class="small text-muted-fs">
                                        @line.VariantName · SKU @line.Sku
                                        @if (line.MaterialName is not null)
                                        {
                                            <span> · @line.MaterialName</span>
                                        }
                                    </div>
                                    <div class="cart-line-price">
                                        <span class="fw-semibold">@Format.Money(line.UnitPrice)</span>
                                        @if (line.OriginalPrice.HasValue)
                                        {
                                            <span class="price-old">@Format.Money(line.OriginalPrice.Value)</span>
                                        }
                                    </div>
                                    @if (line.IsAvailable && line.Stock <= 3 && line.Stock > 0)
                                    {
                                        <div class="small text-warning-emphasis">Chỉ còn @line.Stock sản phẩm</div>
                                    }
                                </div>
                                <div class="cart-line-actions">
                                    <div class="quantity-stepper quantity-stepper-sm">
                                        <form method="post" action="/cart/items/@line.ItemId/quantity" asp-antiforgery="true">
                                            <input type="hidden" name="quantity" value="@(line.Quantity - 1)" />
                                            <button type="submit" class="btn" aria-label="Giảm số lượng @line.ProductName"><i class="bi bi-dash" aria-hidden="true"></i></button>
                                        </form>
                                        <form method="post" action="/cart/items/@line.ItemId/quantity" asp-antiforgery="true">
                                            <label class="visually-hidden" for="qty-@line.ItemId">Số lượng @line.ProductName</label>
                                            <input id="qty-@line.ItemId" type="number" name="quantity" value="@line.Quantity" min="0" max="@Math.Max(1, line.MaxQuantity)" inputmode="numeric" data-autosubmit-quantity />
                                        </form>
                                        <form method="post" action="/cart/items/@line.ItemId/quantity" asp-antiforgery="true">
                                            <input type="hidden" name="quantity" value="@(line.Quantity + 1)" />
                                            <button type="submit" class="btn" aria-label="Tăng số lượng @line.ProductName" disabled="@(line.Quantity >= line.MaxQuantity)"><i class="bi bi-plus" aria-hidden="true"></i></button>
                                        </form>
                                    </div>
                                    <div class="cart-line-total">@Format.Money(line.LineTotal)</div>
                                    <form method="post" action="/cart/items/@line.ItemId/remove" asp-antiforgery="true">
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0"><i class="bi bi-trash me-1" aria-hidden="true"></i>Xóa</button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>
                    <a class="btn btn-link mt-3 px-0" href="/products"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Tiếp tục mua sắm</a>
                </div>

                <div class="col-lg-4">
                    <aside class="order-summary sticky-lg-top">
                        <h2 class="h5 mb-3">Tóm tắt đơn hàng</h2>

                        <partial name="_CouponBox" model="couponBox" />

                        <dl class="summary-lines">
                            <div><dt>Tạm tính</dt><dd>@Format.Money(Model.Subtotal)</dd></div>
                            @if (Model.DiscountAmount > 0)
                            {
                                <div><dt>Giảm giá (@Model.CouponCode)</dt><dd class="text-success">-@Format.Money(Model.DiscountAmount)</dd></div>
                            }
                            <div><dt>Giao hàng &amp; lắp đặt</dt><dd class="text-muted-fs" data-summary="shipping">@Format.ShippingQuotedOnContact</dd></div>
                            <div class="summary-total"><dt>Tổng tiền hàng</dt><dd>@Format.Money(Model.Total)</dd></div>
                        </dl>
                        <p class="small text-muted-fs"><i class="bi bi-truck me-1" aria-hidden="true"></i>Chưa gồm phí giao hàng &amp; lắp đặt: nhân viên báo phí theo địa chỉ khi gọi xác nhận đơn.</p>

                        @if (Model.CanCheckout)
                        {
                            <a class="btn btn-primary btn-lg w-100" href="/checkout"><i class="bi bi-telephone me-1" aria-hidden="true"></i>Liên hệ đặt hàng</a>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-lg w-100" type="button" disabled>Vui lòng cập nhật giỏ hàng</button>
                        }
                        <p class="small text-muted-fs text-center mt-2 mb-0"><i class="bi bi-shield-check me-1" aria-hidden="true"></i>Không thanh toán trực tuyến · cửa hàng gọi xác nhận trước khi giao</p>
                    </aside>
                </div>
            </div>
        }
    </div>
</section>
