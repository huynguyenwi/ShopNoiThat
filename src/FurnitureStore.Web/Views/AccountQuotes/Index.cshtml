@model FurnitureStore.Application.Common.Models.PagedResult<FurnitureStore.Application.Quotes.QuoteListItemDto>
@using FurnitureStore.Domain.Entities
@inject IStoreInfoService StoreInfo
@{
    var store = await StoreInfo.GetAsync(Context.RequestAborted);
    ViewData["Title"] = "Yêu cầu báo giá";
    Func<int, string> pageUrl = p => $"/account/quotes?page={p}";
}

<section class="section pt-4">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3"><partial name="~/Views/Account/_AccountNav.cshtml" /></div>
            <div class="col-lg-9">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
                    <h1 class="h4 mb-0">Yêu cầu báo giá</h1>
                    <a class="btn btn-outline-primary btn-sm" href="/bao-gia"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Yêu cầu mới</a>
                </div>
                @if (Model.Items.Count == 0)
                {
                    <div class="empty-state">
                        <i class="bi bi-calculator" aria-hidden="true"></i>
                        <h2 class="h5 mt-3">Bạn chưa gửi yêu cầu báo giá nào</h2>
                        <p class="text-muted-fs">Cần món nội thất theo kích thước riêng? Xưởng @store.BrandName nhận đóng theo yêu cầu.</p>
                        <a class="btn btn-primary" href="/bao-gia">Nhận báo giá</a>
                    </div>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var q in Model.Items)
                        {
                            <a class="list-group-item list-group-item-action py-3" href="/account/quotes/@q.Code">
                                <div class="d-flex flex-wrap justify-content-between gap-2">
                                    <strong>@q.Code · @q.TypeName</strong>
                                    <span class="badge @QuoteLabels.Badge(q.Status)">@QuoteStatusTransitions.DisplayName(q.Status)</span>
                                </div>
                                <div class="small text-muted-fs mt-1">
                                    @q.Dimensions@(q.MaterialName is null ? "" : " · " + q.MaterialName) · SL @q.Quantity · @Format.DateText(q.CreatedAt)
                                </div>
                                <div class="small mt-1">
                                    Dự kiến <strong>@Format.Money(q.EstimatedTotal)</strong>
                                    @if (q.FinalQuotedPrice is decimal final)
                                    {
                                        <span> · Giá báo <strong class="text-wood">@Format.Money(final)</strong></span>
                                    }
                                </div>
                            </a>
                        }
                    </div>
                    <partial name="_Pagination" model="(Model.Page, Model.TotalPages, pageUrl)" />
                }
            </div>
        </div>
    </div>
</section>
