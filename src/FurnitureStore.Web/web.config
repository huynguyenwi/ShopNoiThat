<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Used only when hosted in IIS (Kestrel ignores it); publishing adds the ASP.NET Core module settings.
       IIS refuses requests over 30 MB by default, while a product form may carry 10 pictures of up to 50 MB.
       Each upload endpoint still enforces its own limit ([RequestSizeLimit]). -->
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="526385152" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
