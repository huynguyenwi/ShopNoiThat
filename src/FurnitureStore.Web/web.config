<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Used only when hosted in IIS (Kestrel ignores it). Publishing fills in processPath / arguments.
       IIS refuses requests over 30 MB by default, while a product form may carry 10 pictures of up to 50 MB.
       Each upload endpoint still enforces its own limit ([RequestSizeLimit]). -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- "HTTP Error 500.30" (the app stopped while starting), two ways to see why:
           1. In the browser: put this inside <aspNetCore> ... </aspNetCore> below, reload the site - the error page then shows
              the startup exception. Remove it right after: it shows stack traces to every visitor.
                <environmentVariables>
                  <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="1" />
                </environmentVariables>
           2. In a file: set stdoutLogEnabled="true", reload the site and read logs\stdout_*.log (the folder is published
              empty). Set it back to "false" afterwards: the file keeps growing. -->
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="526385152" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
